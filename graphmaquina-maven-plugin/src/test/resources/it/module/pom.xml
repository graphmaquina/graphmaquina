<?xml version="1.0" encoding="UTF-8"?>
<!--
  The module of a multi-module build: the basic fixture, turned into a pom parent, configures the compiler and the
  six StateGraph executions once, and this module inherits all of it. It declares nothing but its parent and its
  packaging, which is the point: the parent runs the same inherited executions and compiles nothing.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>fx.build</groupId>
    <artifactId>fixture</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>app</artifactId>
  <packaging>jar</packaging>
</project>
