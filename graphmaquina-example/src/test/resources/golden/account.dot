digraph "Account/AccountStatus" {
    graph [rankdir=LR, bgcolor="#ffffff", pad="0.3", nodesep="0.45", ranksep="0.7", fontname="Helvetica,Arial,sans-serif", fontsize=12, fontcolor="#1b1f3a", labelloc=t, labeljust=l, label=<<b>Account/AccountStatus</b>>];
    node [shape=box, style="rounded,filled", color="#1b1f3a", fillcolor="#ffffff", fontcolor="#1b1f3a", fontname="Helvetica,Arial,sans-serif", fontsize=12, penwidth=1.2, margin="0.18,0.06"];
    edge [color="#4f5677", fontcolor="#1b1f3a", fontname="Helvetica,Arial,sans-serif", fontsize=10, penwidth=1.1, arrowsize=0.7];
    initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
    n0 [label="NEW", tooltip="otherwise: a new account sets its password"];
    n1 [label="PASSWORD_SET", tooltip="otherwise: an account completes its personal info"];
    n2 [label="INFO_SET", tooltip="otherwise: an account completes its address"];
    n3 [label="ADDRESS_SET", tooltip="otherwise: an account is activated"];
    n4 [label="ACTIVE", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state ACTIVE accepts no transitions"];
    n5 [label="PREMIUM", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state PREMIUM accepts no transitions"];
    n6 [label="FLAGGED", tooltip="otherwise: a flagged account is reviewed"];
    n7 [label="REVIEW", tooltip="otherwise: a reviewed account is closed"];
    n8 [label="CLOSED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state CLOSED accepts no transitions"];
    initial -> n0;
    n0 -> n1 [label=<<b>SET_PASSWORD</b>>];
    n1 -> n1 [label=<<b>TOUCH</b>>];
    n1 -> n2 [label=<<b>COMPLETE_INFO</b><br align="left"/><font color="#4f5677">[auto]<br align="left"/>[if infoComplete]<br align="left"/></font>>, color="#2457d6", fontcolor="#2457d6"];
    n2 -> n3 [label=<<b>COMPLETE_ADDRESS</b><br align="left"/><font color="#4f5677">[auto]<br align="left"/>verifyAddress<br align="left"/>[if addressComplete]<br align="left"/>[recover AddressFailures$Unverifiable -&gt; FLAG continues]<br align="left"/></font>>, color="#2457d6", fontcolor="#2457d6"];
    n2 -> n6 [label=<<b>FLAG</b>>];
    n3 -> n5 [label=<<b>ACTIVATE_PREMIUM</b><br align="left"/><font color="#4f5677">[auto 1]<br align="left"/>[if premium]<br align="left"/></font>>, color="#2457d6", fontcolor="#2457d6"];
    n3 -> n4 [label=<<b>ACTIVATE</b><br align="left"/><font color="#4f5677">[auto 2]<br align="left"/></font>>, color="#2457d6", fontcolor="#2457d6"];
    n6 -> n7 [label=<<b>REQUEST_REVIEW</b><br align="left"/><font color="#4f5677">[auto]<br align="left"/></font>>, color="#2457d6", fontcolor="#2457d6"];
    n7 -> n8 [label=<<b>CLOSE</b>>];
}
