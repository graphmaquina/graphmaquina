digraph "Item/ItemStatus" {
    graph [rankdir=LR, bgcolor="#ffffff", pad="0.3", nodesep="0.45", ranksep="0.7", fontname=Helvetica, fontsize=12, fontcolor="#1b1f3a", labelloc=t, labeljust=l, label=<<b>Item/ItemStatus</b>>];
    node [shape=box, style="rounded,filled", color="#1b1f3a", fillcolor="#ffffff", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=12, penwidth=1.2, margin="0.18,0.06"];
    edge [color="#4f5677", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=10, penwidth=1.1, arrowsize=0.7];
    initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
    n0 [label="PENDING", tooltip="otherwise: an item is packed by going through PACKING"];
    n1 [label="PACKING", tooltip="otherwise: cannot go back to pending"];
    n2 [label="PACKED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state PACKED accepts no transitions"];
    n3 [label="CANCELLED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state CANCELLED accepts no transitions"];
    initial -> n0;
    n0 -> n1 [label=<<b>START_PACKING</b>>];
    n0 -> n3 [label=<<b>CANCEL</b><br align="left"/><font color="#4f5677">restock<br align="left"/></font>>];
    n1 -> n2 [label=<<b>PACK</b><br align="left"/><font color="#4f5677">pack<br align="left"/></font>>];
    n1 -> n3 [label=<<b>CANCEL</b><br align="left"/><font color="#4f5677">restock<br align="left"/></font>>];
}
