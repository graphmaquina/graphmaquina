digraph "Item/ItemStatus" {
    rankdir=LR;
    initial [shape=point, label=""];
    n0 [label="PENDING", shape=ellipse];
    n1 [label="PACKING", shape=ellipse];
    n2 [label="PACKED", shape=doublecircle];
    n3 [label="CANCELLED", shape=doublecircle];
    initial -> n0;
    n0 -> n1;
    n0 -> n3;
    n1 -> n2 [label="pack"];
    n1 -> n3;
}
