<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Size and complexity limits for production code (src/main of every module). The limits are a wall: any code over
    a limit, new or existing, fails the build before javac runs, with the exact file and line, until the code is
    within the limits.

    Method limits push towards extracting methods; the per-file limit of 400 statements is generous on purpose, so a
    simple feature fits in one class. Class fan-out is the counterweight to over-splitting: a class that coordinates
    many fragments accumulates dependencies. The numbers are judgment calls, not values taken from a standard; tune
    them here.

    Nothing can switch a check off, on purpose: no annotation, no comment and no file is honored, because no filter
    module is configured. The only way to pass is to split the code or to wrap a long line.

    LineLength ignores package and import lines and whole comment lines (those starting with *, // or /*), so
    Javadoc and explanations are never restricted. A trailing comment on a code line still counts, and so does a line
    that starts with a block comment and is followed by code on the same line.
    Every property not set here keeps its Checkstyle default, for example recordMaximum of JavaNCSS.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <!-- Fixed to English so the messages read the same under any JVM locale. -->
    <property name="localeLanguage" value="en"/>
    <property name="localeCountry" value=""/>
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package|import) .*$|^\s*(\*|//).*$|^\s*/\*(?!.*\*/\s*\S).*$"/>
    </module>
    <module name="TreeWalker">
        <!-- Non-commenting source statements: a statement counts once however many lines it spans. -->
        <module name="JavaNCSS">
            <property name="methodMaximum" value="30"/>
            <property name="classMaximum" value="400"/>
            <property name="fileMaximum" value="400"/>
        </module>
        <!-- Blank lines and comment lines are not counted, so documentation never pushes a method over. -->
        <module name="MethodLength">
            <property name="max" value="50"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="CyclomaticComplexity">
            <property name="max" value="15"/>
        </module>
        <module name="ClassFanOutComplexity">
            <property name="max" value="30"/>
        </module>
    </module>
</module>
