digraph "Booking/BookingStatus" {
    graph [rankdir=LR, bgcolor="#ffffff", pad="0.3", nodesep="0.45", ranksep="0.7", fontname=Helvetica, fontsize=12, fontcolor="#1b1f3a", labelloc=t, labeljust=l, label=<<b>Booking/BookingStatus</b>>];
    node [shape=box, style="rounded,filled", color="#1b1f3a", fillcolor="#ffffff", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=12, penwidth=1.2, margin="0.18,0.06"];
    edge [color="#4f5677", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=10, penwidth=1.1, arrowsize=0.7];
    compound=true;
    initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
    n0 [label="REQUESTED", tooltip="otherwise: a request is booked, paid in full or cancelled"];
    n3 [label="CONFIRMED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state CONFIRMED accepts no transitions"];
    n4 [label="CANCELLED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state CANCELLED accepts no transitions"];
    subgraph cluster_s0 {
        label=<<b>DEPOSIT</b><font color="#4f5677">: Payment/PaymentStatus</font>>;
        graph [style="rounded,filled", color="#d4d8ea", fillcolor="#f5f6fb", fontsize=11, penwidth=1.2];
        tooltip="otherwise: a deposit is paid, restarted or cancelled";
        s0_anchor [shape=point, style=invis, label=""];
        s0_initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
        s0_n0 [label="AUTHORIZING", tooltip="otherwise: an authorization is held, captured, declined or voided"];
        s0_n1 [label="HELD", tooltip="otherwise: a hold is captured, declined or voided"];
        s0_n2 [label="CAPTURED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state CAPTURED accepts no transitions"];
        s0_n3 [label="DECLINED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state DECLINED accepts no transitions"];
        s0_n4 [label="VOIDED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state VOIDED accepts no transitions"];
        s0_initial -> s0_n0;
        s0_n0 -> s0_n1 [label=<<b>HOLD</b>>];
        s0_n0 -> s0_n2 [label=<<b>CAPTURE</b><br align="left"/><font color="#4f5677">Capture<br align="left"/></font>>];
        s0_n0 -> s0_n3 [label=<<b>DECLINE</b>>];
        s0_n0 -> s0_n4 [label=<<b>VOID</b>>];
        s0_n1 -> s0_n2 [label=<<b>CAPTURE</b><br align="left"/><font color="#4f5677">Capture<br align="left"/>[onFailure DECLINE]<br align="left"/></font>>];
        s0_n1 -> s0_n3 [label=<<b>DECLINE</b>>];
        s0_n1 -> s0_n4 [label=<<b>VOID</b>>];
    }
    subgraph cluster_s1 {
        label=<<b>BALANCE</b><font color="#4f5677">: Payment/PaymentStatus</font>>;
        graph [style="rounded,filled", color="#d4d8ea", fillcolor="#f5f6fb", fontsize=11, penwidth=1.2];
        tooltip="otherwise: a balance is paid or cancelled";
        s1_anchor [shape=point, style=invis, label=""];
        s1_initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
        s1_n0 [label="AUTHORIZING", tooltip="otherwise: an authorization is held, captured, declined or voided"];
        s1_n1 [label="HELD", tooltip="otherwise: a hold is captured, declined or voided"];
        s1_n2 [label="CAPTURED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state CAPTURED accepts no transitions"];
        s1_n3 [label="DECLINED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state DECLINED accepts no transitions"];
        s1_n4 [label="VOIDED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state VOIDED accepts no transitions"];
        s1_initial -> s1_n0;
        s1_n0 -> s1_n1 [label=<<b>HOLD</b>>];
        s1_n0 -> s1_n2 [label=<<b>CAPTURE</b><br align="left"/><font color="#4f5677">Capture<br align="left"/></font>>];
        s1_n0 -> s1_n3 [label=<<b>DECLINE</b>>];
        s1_n0 -> s1_n4 [label=<<b>VOID</b>>];
        s1_n1 -> s1_n2 [label=<<b>CAPTURE</b><br align="left"/><font color="#4f5677">Capture<br align="left"/>[onFailure DECLINE]<br align="left"/></font>>];
        s1_n1 -> s1_n3 [label=<<b>DECLINE</b>>];
        s1_n1 -> s1_n4 [label=<<b>VOID</b>>];
    }
    initial -> n0;
    n0 -> s0_n0 [label=<<b>BOOK</b><br align="left"/><font color="#4f5677">TakeDeposit<br align="left"/>[watches Payment: anyIn AUTHORIZING]<br align="left"/></font>>, lhead=cluster_s0];
    n0 -> s1_n0 [label=<<b>PAY_IN_FULL</b><br align="left"/><font color="#4f5677">ChargeInFull<br align="left"/>[onFailure BOOK]<br align="left"/></font>>, lhead=cluster_s1];
    n0 -> n4 [label=<<b>CANCEL</b><br align="left"/><font color="#4f5677">CancelBooking<br align="left"/></font>>];
    s0_anchor -> s0_n0 [label=<<b>RESTART</b>>];
    s0_n2 -> s1_n0 [label=<<b>DEPOSIT_PAID</b><br align="left"/><font color="#4f5677">Settle<br align="left"/>[if Settled]<br align="left"/>[onFailure CANCEL]<br align="left"/></font>>, lhead=cluster_s1];
    s0_n3 -> n4 [label=<<b>PAYMENT_FAILED</b>>];
    s0_n4 -> n4 [label=<<b>PAYMENT_FAILED</b>>];
    s0_anchor -> n4 [label=<<b>CANCEL</b><br align="left"/><font color="#4f5677">CancelBooking<br align="left"/></font>>, ltail=cluster_s0];
    s1_n2 -> n3 [label=<<b>BALANCE_PAID</b><br align="left"/><font color="#4f5677">Confirm<br align="left"/></font>>];
    s1_n3 -> n4 [label=<<b>PAYMENT_FAILED</b>>];
    s1_n4 -> n4 [label=<<b>PAYMENT_FAILED</b>>];
    s1_anchor -> n4 [label=<<b>CANCEL</b><br align="left"/><font color="#4f5677">CancelBooking<br align="left"/></font>>, ltail=cluster_s1];
    watch0 [shape=note, style=filled, color="#a85a00", fillcolor="#fff6e5", fontcolor="#a85a00", label="watches Payment"];
    n0 -> watch0 [style=dashed, arrowhead=none, color="#a85a00"];
}
