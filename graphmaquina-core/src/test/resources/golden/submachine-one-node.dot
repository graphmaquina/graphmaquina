digraph "Payment/PaymentStatus" {
    graph [rankdir=LR, bgcolor="#ffffff", pad="0.3", nodesep="0.45", ranksep="0.7", fontname=Helvetica, fontsize=12, fontcolor="#1b1f3a", labelloc=t, labeljust=l, label=<<b>Payment/PaymentStatus</b>>];
    node [shape=box, style="rounded,filled", color="#1b1f3a", fillcolor="#ffffff", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=12, penwidth=1.2, margin="0.18,0.06"];
    edge [color="#4f5677", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=10, penwidth=1.1, arrowsize=0.7];
    compound=true;
    initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
    n1 [label="HELD", tooltip="otherwise: a hold is captured, declined or voided"];
    n2 [label="CAPTURED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state CAPTURED accepts no transitions"];
    n3 [label="DECLINED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state DECLINED accepts no transitions"];
    n4 [label="VOIDED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state VOIDED accepts no transitions"];
    subgraph cluster_s0 {
        label=<<b>AUTHORIZING</b><font color="#4f5677">: Payment/RiskStatus</font>>;
        graph [style="rounded,filled", color="#d4d8ea", fillcolor="#f5f6fb", fontsize=11, penwidth=1.2];
        tooltip="otherwise: an authorization is held, captured, declined or voided";
        s0_anchor [shape=point, style=invis, label=""];
        s0_initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
        s0_n0 [label="SCORING", tooltip="otherwise: a risk score clears or flags the payment"];
        s0_n1 [label="CLEARED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state CLEARED accepts no transitions"];
        s0_n2 [label="FLAGGED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state FLAGGED accepts no transitions"];
        s0_initial -> s0_n0;
        s0_n0 -> s0_n1 [label=<<b>CLEAR</b>>];
        s0_n0 -> s0_n2 [label=<<b>FLAG</b>>];
    }
    initial -> s0_n0 [lhead=cluster_s0];
    s0_n1 -> n1 [label=<<b>HOLD</b>>];
    s0_anchor -> n2 [label=<<b>CAPTURE</b><br align="left"/><font color="#4f5677">Capture<br align="left"/></font>>, ltail=cluster_s0];
    s0_n2 -> n3 [label=<<b>DECLINE</b>>];
    s0_anchor -> n4 [label=<<b>VOID</b>>, ltail=cluster_s0];
    n1 -> n2 [label=<<b>CAPTURE</b><br align="left"/><font color="#4f5677">Capture<br align="left"/>[onFailure DECLINE]<br align="left"/></font>>];
    n1 -> n3 [label=<<b>DECLINE</b>>];
    n1 -> n4 [label=<<b>VOID</b>>];
}
