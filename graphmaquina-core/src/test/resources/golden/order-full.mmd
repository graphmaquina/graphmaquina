stateDiagram-v2
    [*] --> NEW
    NEW --> NEW : stay
    NEW --> PAID : ChargeCard [async] [if RetryBudgetLeft]
    NEW --> PAYMENT_DECLINED : [failure of ChargeCard]
    NEW --> SHIPPED : forbid: cannot ship without payment
    NEW --> CANCELLED : CancelOrder
    PAID --> NEW : forbid: money was charged: requires a refund
    PAID --> PAID : stay
    PAID --> PAYMENT_DECLINED : forbid: money was charged: requires a refund
    PAID --> SHIPPED : ShipOrder [if AllItemsPacked] [watches Item: allIn PACKED]
    PAID --> CANCELLED : forbid: money was charged: requires a refund
    PAYMENT_DECLINED --> NEW : [if RetryBudgetLeft]
    PAYMENT_DECLINED --> PAID : forbid: go back to NEW to retry the charge
    PAYMENT_DECLINED --> PAYMENT_DECLINED : stay
    PAYMENT_DECLINED --> SHIPPED : forbid: go back to NEW to retry the charge
    PAYMENT_DECLINED --> CANCELLED : CancelOrder
    SHIPPED --> NEW : forbid: a shipment cannot be undone
    SHIPPED --> PAID : forbid: a shipment cannot be undone
    SHIPPED --> PAYMENT_DECLINED : forbid: a shipment cannot be undone
    SHIPPED --> SHIPPED : stay
    SHIPPED --> CANCELLED : forbid: a shipment cannot be undone
    CANCELLED --> NEW : forbid: cancelled is final
    CANCELLED --> PAID : forbid: cancelled is final
    CANCELLED --> PAYMENT_DECLINED : forbid: cancelled is final
    CANCELLED --> SHIPPED : forbid: cancelled is final
    CANCELLED --> CANCELLED : stay
    SHIPPED --> [*]
    CANCELLED --> [*]
    note right of PAID : watches Item
