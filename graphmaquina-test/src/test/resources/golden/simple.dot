digraph "Entity/State" {
    graph [rankdir=LR, bgcolor="#ffffff", pad="0.3", nodesep="0.45", ranksep="0.7", fontname=Helvetica, fontsize=12, fontcolor="#1b1f3a", labelloc=t, labeljust=l, label=<<b>Entity/State</b>>];
    node [shape=box, style="rounded,filled", color="#1b1f3a", fillcolor="#ffffff", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=12, penwidth=1.2, margin="0.18,0.06"];
    edge [color="#4f5677", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=10, penwidth=1.1, arrowsize=0.7];
    initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
    n0 [label="NEW", tooltip="otherwise: prepare first"];
    n1 [label="READY", tooltip="otherwise: finish only"];
    n2 [label="DONE", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state DONE accepts no transitions"];
    n3 [label="FAILED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state FAILED accepts no transitions"];
    initial -> n0;
    n0 -> n1 [label=<<b>PREPARE</b><br align="left"/><font color="#4f5677">prepare<br align="left"/>[async]<br align="left"/>[if first, second]<br align="left"/>[onFailure RECOVER]<br align="left"/></font>>];
    n0 -> n3 [label=<<b>RECOVER</b>>];
    n1 -> n2 [label=<<b>FINISH</b>>];
}
