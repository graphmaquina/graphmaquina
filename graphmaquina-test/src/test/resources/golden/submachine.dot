digraph "String/Stage" {
    graph [rankdir=LR, bgcolor="#ffffff", pad="0.3", nodesep="0.45", ranksep="0.7", fontname=Helvetica, fontsize=12, fontcolor="#1b1f3a", labelloc=t, labeljust=l, label=<<b>String/Stage</b>>];
    node [shape=box, style="rounded,filled", color="#1b1f3a", fillcolor="#ffffff", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=12, penwidth=1.2, margin="0.18,0.06"];
    edge [color="#4f5677", fontcolor="#1b1f3a", fontname=Helvetica, fontsize=10, penwidth=1.1, arrowsize=0.7];
    compound=true;
    initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
    n0 [label="DRAFT", tooltip="otherwise: submit the draft"];
    n2 [label="ACCEPTED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state ACCEPTED accepts no transitions"];
    n3 [label="DROPPED", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state DROPPED accepts no transitions"];
    subgraph cluster_s0 {
        label=<<b>REVIEW</b><font color="#4f5677">: String/Step</font>>;
        graph [style="rounded,filled", color="#d4d8ea", fillcolor="#f5f6fb", fontsize=11, penwidth=1.2];
        tooltip="otherwise: the review decides";
        s0_anchor [shape=point, style=invis, label=""];
        s0_initial [shape=point, width=0.14, height=0.14, fillcolor="#1b1f3a", label=""];
        s0_n0 [label="A", tooltip="otherwise: a branches"];
        s0_n1 [label="B", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state B accepts no transitions"];
        s0_n2 [label="C", peripheries=2, fillcolor="#1b1f3a", fontcolor="#ffffff", tooltip="otherwise: terminal state C accepts no transitions"];
        s0_initial -> s0_n0;
        s0_n0 -> s0_n1 [label=<<b>ADVANCE</b>>];
        s0_n0 -> s0_n2 [label=<<b>SKIP</b>>];
    }
    initial -> n0;
    n0 -> s0_n0 [label=<<b>SUBMIT</b>>, lhead=cluster_s0];
    s0_n1 -> n2 [label=<<b>ACCEPT</b>>];
    s0_n2 -> n3 [label=<<b>DROP</b>>];
}
